#Ignore general log files
.log
npm-debug.log
yarn-debug.log*
yarn-error.log*

#Ignore IDE files
#IntelliJ
.idea/
*.iml
*.iws

#VS Code
.vscode/

#This path targets the Maven parent project and all its sub-modules
# Ignore build and distribution folders
JournalApp-Backend/target/
journal_App_Frontend/dist/
journal_App_Frontend/build/

#Ignore Java build files
JournalApp/target/JournalApp//target/JournalApp//.mvn/

#Ignore compiled class files
*.class

#Ignore package files
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

#Ignore virtual machine crash logs
hs_err_pid*

#Ignore operating system files
.DS_Store
Thumbs.db

# Ignore dependency folders
node_modules/
bin/

# Ignore Maven Wrapper (optional, but keeps repo clean)
.mvn/
mvnw
mvnw.cmd